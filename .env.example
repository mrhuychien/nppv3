# Supabase SSR (khuyến nghị key publishable mới)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Tương thích môi trường nppv2 trong giai đoạn chuyển tiếp.
# Chỉ cần khi project Supabase cũ chưa chuyển sang publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chỉ được đọc ở server; không thêm tiền tố NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
EINVOICE_ENC_KEY=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
